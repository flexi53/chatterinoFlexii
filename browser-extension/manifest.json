{
  "manifest_version": 3,
  "name": "ChattiFlexii Tab-Folger",
  "version": "1.0",
  "description": "Sagt ChattiFlexii, welchen Twitch-Kanal du gerade anschaust, damit der passende Tab nach vorne kommt.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-folger@chattiflexii"
    }
  },
  "key": ""
}
